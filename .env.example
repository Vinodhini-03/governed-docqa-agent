ENV=dev                      # set to prod to refuse the default JWT secret
JWT_SECRET=change-me
STORE=local                  # local | azure
LLM_PROVIDER=extractive      # extractive | groq | ollama | azure_openai
MIN_CONFIDENCE=0.5
TOP_K=5

# Document Intelligence (optional; PDFs fall back to pypdf without it)
DOCINTEL_ENDPOINT=
DOCINTEL_KEY=

# Azure AI Search (STORE=azure)
SEARCH_ENDPOINT=
SEARCH_KEY=
SEARCH_INDEX=docqa-chunks

# LLM providers
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_EMBED_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-06-01

# Secrets via Key Vault (optional; env vars win if present)
KEY_VAULT_URL=
APPLICATIONINSIGHTS_CONNECTION_STRING=
